{
  "name": "jate-studio",
  "version": "2.0.0",
  "private": true,
  "description": "An offline-first personal document and code editor.",
  "scripts": {
    "postinstall": "npm --prefix client install --no-audit --no-fund",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "dev": "npm --prefix client run dev",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
